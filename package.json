  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "playwright-core": "1.62.0",
    "steel-sdk": "0.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
