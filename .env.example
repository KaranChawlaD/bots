# Steel.dev API key — https://app.steel.dev
STEEL_API_KEY=

# Optional: point at a self-hosted Steel instance
# STEEL_BASE_URL=http://localhost:3000

# One variable per account, matching "passwordEnv" in accounts.json
KIJIJI_PASSWORD_PRIMARY=
KIJIJI_PASSWORD_SECONDARY=

# Authenticator secrets for accounts with two-factor auth ("totpSecretEnv")
# KIJIJI_TOTP_SECONDARY=

# Verbose agent logging
# KIJIJI_DEBUG=1
